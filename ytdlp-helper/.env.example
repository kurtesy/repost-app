# Port this service listens on (put nginx or a reverse proxy in front for TLS in production).
PORT=8088

# Shared secret the main app must send as `Authorization: Bearer <this value>`. Generate a long
# random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match YTDLP_HELPER_SECRET in the main repost-app's Vercel environment variables exactly.
HELPER_SECRET=

# Vercel Blob read-write token. Create one at https://vercel.com/dashboard -> your project ->
# Storage -> create a Blob store -> copy its BLOB_READ_WRITE_TOKEN. This is the SAME store the
# main app's project should use, so tokens land somewhere the main app can also see/manage them.
#
# LOCAL DEVELOPMENT: leave this blank to skip Vercel Blob entirely. With no token set, this
# service serves downloaded files itself (at /local-blob/<name>) instead of uploading to Blob —
# fine for testing Reels against a locally-run main app + locally-run helper, not for a real
# deployment (see PUBLIC_BASE_URL below and DEPLOY.md's "Local development" section).
BLOB_READ_WRITE_TOKEN=

# Only used when BLOB_READ_WRITE_TOKEN above is blank (local-serve mode). The base URL this
# service's own downloaded-file links are built from — must be a URL the MAIN app can reach.
# Defaults to http://localhost:$PORT, which is correct when both services run on the same
# machine (the normal local-dev setup). Change this only if the main app reaches this helper at
# a different host/port than this service's own PORT.
PUBLIC_BASE_URL=http://localhost:8088

# Path to the yt-dlp executable. Leave this UNSET/commented out to use the project-local venv
# created during setup (see DEPLOY.md) — the app resolves that default correctly on its own
# regardless of which directory the process is started from. Only set this if you installed
# yt-dlp globally instead (e.g. `which yt-dlp`'s output) or placed the venv somewhere non-default.
# A relative path here (e.g. ./.venv/bin/yt-dlp) is resolved against this ytdlp-helper/ folder
# itself, not against whatever directory you happen to run `npm start` from — but an absolute
# path avoids any ambiguity if you do set this.
# YTDLP_PATH=./.venv/bin/yt-dlp
