# ===================================================================
# Copy this file to ".env" and fill in real values. See SETUP.md.
# ===================================================================

# --- App ---
PORT=3011
HTTPS_PORT=3443
BASE_URL=http://localhost:3011
SESSION_SECRET=change-this-to-a-random-long-string

# --- Instagram (Meta Graph API) ---
# Meta App > Instagram API with Instagram Login (or Facebook Login for Business)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3011/auth/instagram/callback
# Long-lived Page/IG User access token can also be pasted directly to skip OAuth:
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- YouTube (Google Cloud) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:3011/auth/youtube/callback

# --- TikTok (TikTok for Developers) ---
# TikTok's Login Kit rejects "localhost" redirect URIs outright (even over https), so this
# points at a small static relay page deployed alongside the legal/ site on Vercel — it shows
# you the authorization code on screen, which you then paste into the dashboard's "Complete
# TikTok connection" field. See SETUP.md section 4 for the full walkthrough.
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_REDIRECT_URI=https://repost-tool.vercel.app/tiktok-callback
