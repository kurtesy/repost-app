# ===================================================================
# Copy this file to ".env" and fill in real values. See SETUP.md.
# ===================================================================

# --- App ---
PORT=3011
HTTPS_PORT=3443
BASE_URL=http://localhost:3011
SESSION_SECRET=change-this-to-a-random-long-string

# Required. Single shared password gating the entire dashboard + all API routes (no user
# accounts). The app refuses to serve anything if this is unset. See SETUP-MIGRATION.md.
DASHBOARD_PASSWORD=

# --- Hosted deployment (Vercel + Neon + yt-dlp helper) — see SETUP-MIGRATION.md ---
# Neon Postgres connection string. Already wired into server/db/index.js.
DATABASE_URL=

# Shared secret Vercel Cron must present (as `Authorization: Bearer $CRON_SECRET`) to call
# GET /api/cron/tick. Set the SAME value in this env var and in vercel.json's cron config /
# Vercel project settings — see server/routes/cron.js and double-check the exact header
# convention against current Vercel Cron docs before deploying.
CRON_SECRET=

# Base URL of the separate yt-dlp helper service (runs on a VPS, not on Vercel) that downloads
# Instagram Reels via yt-dlp and uploads them to Vercel Blob. e.g. https://your-vps-host:PORT/download
YTDLP_HELPER_URL=
# Shared secret sent as `Authorization: Bearer $YTDLP_HELPER_SECRET` to the helper service above.
YTDLP_HELPER_SECRET=

# --- Instagram (Meta Graph API) ---
# Meta App > Instagram API with Instagram Login (or Facebook Login for Business)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3011/auth/instagram/callback
# Long-lived Page/IG User access token can also be pasted directly to skip OAuth:
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- YouTube (Google Cloud) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:3011/auth/youtube/callback

# --- TikTok (TikTok for Developers) ---
# TikTok's Login Kit rejects "localhost" redirect URIs outright (even over https), so this
# points at a small static relay page deployed alongside the legal/ site on Vercel — it shows
# you the authorization code on screen, which you then paste into the dashboard's "Complete
# TikTok connection" field. See SETUP.md section 4 for the full walkthrough.
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_REDIRECT_URI=https://repost-tool.vercel.app/tiktok-callback
